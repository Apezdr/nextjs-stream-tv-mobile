     private fun errorMessageFromException(exception: PlaybackException): String {
-      val reason = "${exception.localizedMessage} ${exception.cause?.localizedMessage ?: ""}"
+      // Name the error code and the cause's class as well as its message:
+      // message-less causes (an IllegalArgumentException from an audio-sink
+      // assertion, a NullPointerException) otherwise surface as a bare
+      // "Unexpected runtime error" that no client logic or telemetry can act
+      // on. Cause messages still come through verbatim, so existing matchers
+      // on them keep working.
+      val causeText = exception.cause?.let { cause ->
+        val message = cause.localizedMessage
+        if (message.isNullOrBlank()) cause.javaClass.simpleName else "${cause.javaClass.simpleName}: $message"
+      }
+      val reason = listOfNotNull(
+        exception.localizedMessage,
+        "[${exception.errorCodeName}]",
+        causeText
+      ).joinToString(" ")
       return "A playback exception has occurred: $reason"
     }
   }
