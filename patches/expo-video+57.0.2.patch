+package expo.modules.video.player
+
+import android.content.Context
+import android.hardware.display.DisplayManager
+import android.view.Display
+
+/** What the default display says it can show, as Android's HdrCapabilities ints. */
+object DisplayHdr {
+  fun supportedTypes(context: Context): List<Int> {
+    val manager = context.getSystemService(Context.DISPLAY_SERVICE) as? DisplayManager ?: return emptyList()
+    val display = manager.getDisplay(Display.DEFAULT_DISPLAY) ?: return emptyList()
+    return display.hdrCapabilities?.supportedHdrTypes?.toList() ?: emptyList()
+  }
+}
