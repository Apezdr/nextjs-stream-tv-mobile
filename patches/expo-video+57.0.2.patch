+package expo.modules.video.player
+
+import androidx.media3.common.Format
+import androidx.media3.common.Tracks
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.hls.HlsManifest
+
+/**
+ * Track ids for formats that reach the app without one.
+ *
+ * media3 1.11 prepares HLS track groups from HlsRedundantGroup.GroupKey
+ * formats, which are built with setId(null).setMetadata(null): every HLS
+ * variant, audio rendition and subtitle rendition arrives with a null id, and
+ * ids are how tracks are listed and selected here (each fromFormat returns
+ * null without one, so every HLS track list came back empty). Recover the
+ * playlist id — the variant index, the "GROUP-ID:NAME" rendition id — by
+ * matching the multivariant playlist's formats after the same normalisation
+ * the group key applies, then by a looser identity when the exposed format
+ * was enriched by sample data; fall back to "<track group id>:<index>".
+ */
+@OptIn(UnstableApi::class)
+object HlsFormatIds {
+  private fun keyOf(format: Format): Format =
+    format.buildUpon().setId(null).setMetadata(null).build()
+
+  private fun looseKey(format: Format): List<Any?> = listOf(
+    format.sampleMimeType ?: format.codecs,
+    format.codecs,
+    format.language,
+    format.label,
+    format.channelCount,
+    format.width,
+    format.height,
+    format.peakBitrate,
+    format.averageBitrate
+  )
+
+  private fun playlistFormats(manifest: HlsManifest?): List<Format> {
+    val playlist = manifest?.multivariantPlaylist ?: return emptyList()
+    return buildList {
+      playlist.variants.forEach { add(it.format) }
+      playlist.audios.forEach { add(it.format) }
+      playlist.subtitles.forEach { add(it.format) }
+      playlist.closedCaptions.forEach { add(it.format) }
+    }
+  }
+
+  /** The playlist format id this exposed format corresponds to, or null. */
+  fun playlistId(format: Format, manifest: HlsManifest?): String? {
+    format.id?.let { return it }
+    val candidates = playlistFormats(manifest).filter { it.id != null }
+    if (candidates.isEmpty()) return null
+    val key = keyOf(format)
+    val exact = candidates.filter { keyOf(it) == key }.mapNotNull { it.id }.distinct()
+    if (exact.size == 1) return exact[0]
+    val loose = looseKey(format)
+    val relaxed = candidates.filter { looseKey(it) == loose }.mapNotNull { it.id }.distinct()
+    return if (relaxed.size == 1) relaxed[0] else null
+  }
+
+  fun resolve(format: Format, manifest: HlsManifest?, group: Tracks.Group, index: Int): String =
+    playlistId(format, manifest) ?: "${group.mediaTrackGroup.id}:$index"
+}
