+package expo.modules.video.player
+
+import android.content.Context
+import androidx.media3.common.Format
+import androidx.media3.common.MimeTypes
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.mediacodec.MediaCodecInfo
+import androidx.media3.exoplayer.mediacodec.MediaCodecUtil
+
+/**
+ * The question media3's video renderer asks before a track is selected: is
+ * there a decoder for this MIME type, and does it accept this codec
+ * profile/level, size and frame rate (MediaCodecInfo.isFormatSupported)?
+ *
+ * Answers:
+ *  - "hardware" / "software": a decoder accepts the format.
+ *  - "exceeds": decoders exist for the MIME type but none accepts this
+ *    profile/level, size or rate. media3 still selects such a track as a last
+ *    resort, which ends in a decoder error or a slideshow.
+ *  - "unsupported": no decoder at all. media3 leaves the track unselected and
+ *    raises no error: audio plays over a black screen.
+ *  - "unknown": the question could not be formed (no MIME type).
+ */
+@UnstableApi
+object VideoFormatSupport {
+  fun probe(context: Context, mimeType: String?, codecs: String?, width: Int, height: Int, frameRate: Double): Map<String, Any?> {
+    val codecString = codecs?.takeIf { it.isNotBlank() }
+    val mime = mimeType?.takeIf { it.isNotBlank() } ?: codecString?.let { MimeTypes.getMediaMimeType(it) }
+    if (mime == null) {
+      return mapOf("support" to "unknown", "reason" to "no-mime", "decoders" to emptyList<String>())
+    }
+    val format = Format.Builder()
+      .setSampleMimeType(mime)
+      .apply {
+        codecString?.let { setCodecs(it) }
+        if (width > 0) setWidth(width)
+        if (height > 0) setHeight(height)
+        if (frameRate > 0) setFrameRate(frameRate.toFloat())
+      }
+      .build()
+
+    var probedMime = mime
+    var infos = decoderInfos(mime)
+    if (infos.isEmpty()) {
+      // The renderer's own fallback: a Dolby Vision format may be decoded by
+      // the HEVC/AVC decoder of its base layer.
