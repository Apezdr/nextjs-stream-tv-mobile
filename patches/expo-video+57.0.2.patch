@@ -0,0 +1,187 @@
+package expo.modules.video.player
+
+import android.content.Context
+import android.media.MediaFormat
+import android.os.Handler
+import androidx.media3.common.Format
+import androidx.media3.common.MimeTypes
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.Renderer
+import androidx.media3.exoplayer.audio.AudioRendererEventListener
+import androidx.media3.exoplayer.audio.AudioSink
+import androidx.media3.exoplayer.audio.MediaCodecAudioRenderer
+import androidx.media3.exoplayer.mediacodec.MediaCodecAdapter
+import androidx.media3.exoplayer.mediacodec.MediaCodecInfo
+import androidx.media3.exoplayer.mediacodec.MediaCodecSelector
+import androidx.media3.extractor.FlacStreamMetadata
+import java.nio.ByteBuffer
+
+/**
+ * A [DefaultRenderersFactory] whose audio renderer sizes the decoder's input
+ * buffers for FLAC.
+ *
+ * MatroskaExtractor sets no maxInputSize on FLAC tracks (it does for Vorbis and
+ * Opus), so KEY_MAX_INPUT_SIZE is never passed to the codec and software FLAC
+ * decoders fall back to their default 32 KB input buffer. Any frame larger than
+ * that — routine for multichannel 24-bit audio — throws
+ * DecoderInputBuffer.InsufficientCapacityException while feeding the codec,
+ * which leaves DefaultAudioSink holding a stale buffer and ends playback with
+ * an opaque "Unexpected runtime error" (IllegalArgumentException from the
+ * sink's inputBuffer assertion). Observed on a SHIELD with a 34,703-byte frame.
+ */
+@UnstableApi
+class FlacSafeRenderersFactory(context: Context) : DefaultRenderersFactory(context) {
+  override fun buildAudioRenderers(
+    context: Context,
+    extensionRendererMode: Int,
+    mediaCodecSelector: MediaCodecSelector,
+    enableDecoderFallback: Boolean,
+    audioSink: AudioSink,
+    eventHandler: Handler,
+    eventListener: AudioRendererEventListener,
+    out: ArrayList<Renderer>
+  ) {
+    super.buildAudioRenderers(
+      context,
+      extensionRendererMode,
+      mediaCodecSelector,
+      enableDecoderFallback,
+      audioSink,
+      eventHandler,
+      eventListener,
+      out
+    )
+    val replacement = FlacSafeMediaCodecAudioRenderer(
+      context,
+      codecAdapterFactory,
+      mediaCodecSelector,
+      enableDecoderFallback,
+      eventHandler,
+      eventListener,
+      audioSink
+    )
+    // Swap the stock renderer in place so ordering relative to any extension
+    // renderers is unchanged.
+    val index = out.indexOfFirst { it is MediaCodecAudioRenderer }
+    if (index >= 0) out[index] = replacement else out.add(replacement)
+  }
+}
+
+@UnstableApi
+private class FlacSafeMediaCodecAudioRenderer(
+  context: Context,
+  codecAdapterFactory: MediaCodecAdapter.Factory,
+  mediaCodecSelector: MediaCodecSelector,
+  enableDecoderFallback: Boolean,
+  eventHandler: Handler?,
+  eventListener: AudioRendererEventListener?,
+  audioSink: AudioSink
+) : MediaCodecAudioRenderer(
+  context,
+  codecAdapterFactory,
+  mediaCodecSelector,
+  enableDecoderFallback,
+  eventHandler,
+  eventListener,
+  audioSink
+) {
+  override fun getCodecMaxInputSize(
+    codecInfo: MediaCodecInfo,
+    format: Format,
+    streamFormats: Array<Format>
+  ): Int {
+    val inherited = super.getCodecMaxInputSize(codecInfo, format, streamFormats)
+    if (format.sampleMimeType != MimeTypes.AUDIO_FLAC) return inherited
+    // inherited is Format.NO_VALUE (-1) whenever the container gave nothing.
+    return maxOf(inherited, flacMaxInputSize(format))
+  }
+
+  override fun getMediaFormat(
+    format: Format,
+    codecMimeType: String,
+    codecMaxInputSize: Int,
+    codecOperatingRate: Float
+  ): MediaFormat {
+    val mediaFormat =
+      super.getMediaFormat(format, codecMimeType, codecMaxInputSize, codecOperatingRate)
+    if (format.sampleMimeType == MimeTypes.AUDIO_FLAC) {
+      canonicalFlacConfig(format)?.let { csd ->
+        mediaFormat.setByteBuffer("csd-0", ByteBuffer.wrap(csd))
+      }
+    }
+    return mediaFormat
+  }
+
+  /**
+   * Android's FLAC decoder takes the "fLaC" marker followed by one STREAMINFO
+   * block as codec config. Matroska CodecPrivate carries the whole metadata
+   * header (STREAMINFO plus VORBIS_COMMENT, PICTURE, ...), which the SHIELD's
+   * decoder rejects — logging "decodeOneFrame: no streaminfo metadata block"
+   * for every frame — and then decodes blind. Returns marker + STREAMINFO with
+   * the last-metadata-block flag set, or null when the data isn't that shape
+   * (leaving the stock csd untouched).
+   */
+  private fun canonicalFlacConfig(format: Format): ByteArray? {
+    val data = format.initializationData.firstOrNull() ?: return null
+    val offset = streamInfoOffset(data) ?: return null
+    if (data.size < offset + STREAMINFO_SIZE) return null
+    val out = ByteArray(FLAC_MARKER.size + 4 + STREAMINFO_SIZE)
+    System.arraycopy(FLAC_MARKER, 0, out, 0, FLAC_MARKER.size)
+    out[4] = 0x80.toByte() // last-metadata-block flag | block type 0 (STREAMINFO)
+    out[5] = 0
+    out[6] = 0
+    out[7] = STREAMINFO_SIZE.toByte()
+    System.arraycopy(data, offset, out, 8, STREAMINFO_SIZE)
+    return out
+  }
+
+  private fun flacMaxInputSize(format: Format): Int {
+    val streamInfo = format.initializationData.firstOrNull()?.let(::parseStreamInfo)
+      ?: return FALLBACK_MAX_INPUT_SIZE
+    val bound = when {
+      streamInfo.maxFrameSize > 0 -> streamInfo.maxFrameSize
+      // Unknown max frame size: a FLAC frame cannot materially exceed the
+      // decoded block (verbatim subframes are raw samples plus headers).
+      streamInfo.maxBlockSizeSamples > 0 ->
+        streamInfo.maxBlockSizeSamples * streamInfo.channels * ((streamInfo.bitsPerSample + 7) / 8)
+      else -> return FALLBACK_MAX_INPUT_SIZE
+    }
+    return maxOf(bound + FRAME_OVERHEAD_BYTES, MIN_MAX_INPUT_SIZE)
+  }
+
+  /**
+   * Offset of the 34-byte STREAMINFO body inside FLAC codec config. Matroska
+   * A_FLAC CodecPrivate is the "fLaC" marker followed by metadata blocks,
+   * STREAMINFO first; other containers hand over the bare block, with or
+   * without its 4-byte header. Null when nothing fits.
+   */
+  private fun streamInfoOffset(data: ByteArray): Int? = when {
+    data.size >= FLAC_MARKER.size + 4 + STREAMINFO_SIZE &&
+      data.copyOfRange(0, FLAC_MARKER.size).contentEquals(FLAC_MARKER) &&
+      (data[4].toInt() and 0x7f) == 0 -> 8
+    data.size >= 4 + STREAMINFO_SIZE && (data[0].toInt() and 0x7f) == 0 -> 4
+    data.size >= STREAMINFO_SIZE -> 0
+    else -> null
+  }
+
+  private fun parseStreamInfo(data: ByteArray): FlacStreamMetadata? {
+    val offset = streamInfoOffset(data) ?: return null
+    return try {
+      FlacStreamMetadata(data, offset)
+    } catch (e: Exception) {
+      null
+    }
+  }
+
+  private companion object {
+    val FLAC_MARKER = byteArrayOf('f'.code.toByte(), 'L'.code.toByte(), 'a'.code.toByte(), 'C'.code.toByte())
+    const val STREAMINFO_SIZE = 34
+    // Frame header, subframe headers and CRC on top of the sample payload.
+    const val FRAME_OVERHEAD_BYTES = 1024
+    // Floor for streams whose frames are small anyway: costs nothing.
+    const val MIN_MAX_INPUT_SIZE = 64 * 1024
+    // Unparseable STREAMINFO: comfortably above any real-world FLAC frame.
+    const val FALLBACK_MAX_INPUT_SIZE = 1024 * 1024
+  }
+}
diff --git a/node_modules/expo-video/android/src/main/java/expo/modules/video/player/HlsFormatIds.kt b/node_modules/expo-video/android/src/main/java/expo/modules/video/player/HlsFormatIds.kt
