+    /**
+     * Dolby Vision profiles the device's decoders advertise, as profile
+     * numbers (4, 5, 8, ...), so a client can gate a raw file's `dvProfile`
+     * before opening it. Android reports profiles as bit flags on
+     * MediaCodecInfo.CodecProfileLevel; the map below is that table.
+     */
+    @ReactMethod
+    fun getDolbyVisionProfiles(p: Promise) {
+        val flagToProfile = mapOf(
+            0x1 to 0, 0x2 to 1, 0x4 to 2, 0x8 to 3, 0x10 to 4, 0x20 to 5,
+            0x40 to 6, 0x80 to 7, 0x100 to 8, 0x200 to 9, 0x400 to 10
+        )
+        val profiles = sortedSetOf<Int>()
+        try {
+            val codecs = MediaCodecList(MediaCodecList.REGULAR_CODECS)
+            for (info in codecs.codecInfos) {
+                if (info.isEncoder) continue
+                if (!info.supportedTypes.any { it.equals(DOLBY_VISION_MIME, ignoreCase = true) }) continue
+                val caps = try {
+                    info.getCapabilitiesForType(DOLBY_VISION_MIME)
+                } catch (e: IllegalArgumentException) {
+                    continue
+                }
+                for (level in caps.profileLevels) {
+                    flagToProfile[level.profile]?.let { profiles.add(it) }
+                }
+            }
+        } catch (e: Exception) {
+            p.reject("E_DV_PROBE", e)
+            return
+        }
+        val result = Arguments.createArray()
+        profiles.forEach { result.pushInt(it) }
+        p.resolve(result)
+    }
